# 手動編集: 可 - Terraform とプロバイダーのバージョン制約を意図して変更する。
# 概要:
# Terraform CLI とプロバイダーのバージョン制約を定義する。
#
# 詳細:
# バージョンを明示して、別環境で実行したときの挙動差分を小さくする。
# ブートストラップは AWS プロバイダーだけを使い、S3 ステートバケットを作成する。

# Terraform 自体と必要なプロバイダーを宣言するトップレベル設定。
terraform {
  # Terraform test などを含む現在の学習範囲で使う最小バージョン。
  required_version = ">= 1.6.0"

  # この構成が利用するプロバイダーとその取得元を固定する。
  required_providers {
    # AWS リソースを管理するための公式プロバイダー。
    aws = {
      # HashiCorp レジストリの AWS プロバイダーを利用する。
      source = "hashicorp/aws"
      # 互換性を保ちながら 6.x 系のパッチ/マイナー更新を許可する。
      version = "~> 6.0"
    }
  }
}
