# 手動編集: 可 - サンプル値だけを変更し、実際の secret は書かない。
# Example values for local Terraform validation and plan review.
# Copy this file to dev.tfvars before running plan, and do not commit real values.

project_name = "study-aws"
environment  = "dev"
aws_region   = "ap-northeast-1"

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
aws_endpoint_url            = "http://localhost:4566"

vpc_cidr = "10.0.0.0/16"
az_count = 2

availability_zone_names = [
  "ap-northeast-1a",
  "ap-northeast-1c",
]

app_port                  = 8080
db_port                   = 5432
db_name                   = "todo_api"
db_username               = "todo"
db_engine_version         = "16"
db_parameter_group_family = "postgres16"
db_instance_class         = "db.t4g.micro"
db_allocated_storage      = 20
db_max_allocated_storage  = 50
db_backup_retention_days  = 7
db_sslmode                = "require"

ecr_repository_name                    = "todo-api"
image_tag                              = "latest"
log_retention_days                     = 7
health_check_path                      = "/readyz"
container_health_check_path            = "/healthz"
ecs_desired_count                      = 1
ecs_deployment_minimum_healthy_percent = 100
ecs_deployment_maximum_percent         = 200
ecs_task_cpu                           = 256
ecs_task_memory                        = 512
ecr_lifecycle_untagged_days            = 7

github_repository         = "YujiYabe/study_iac_aws"
github_default_branch     = "main"
github_deploy_environment = "dev"

tags = {
  Project     = "study-aws"
  Environment = "dev"
  ManagedBy   = "terraform"
}
